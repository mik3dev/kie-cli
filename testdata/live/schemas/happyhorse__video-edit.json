{
  "model": "happyhorse/video-edit",
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "kie.ai",
      "description": "kie.ai API 文档",
      "version": "1.0.0",
      "contact": {
        "name": "技术支持",
        "email": "support@kie.ai"
      }
    },
    "tags": [],
    "paths": {
      "/api/v1/jobs/createTask": {
        "post": {
          "summary": "HappyHorse - video-edit",
          "deprecated": false,
          "description": "## Overview\n\nThe output has the same duration as the input video and is rendered at the selected resolution.\n\n:::tip\nBilled on input video duration + output duration; the output is as long as the input video. For current prices, see [kie.ai/pricing](https://kie.ai/pricing).\n:::\n\n## Query Task Status\n\nAfter submitting a task, use the unified query endpoint to check progress and retrieve results:\n\n<Card title=\"Get Task Details\" icon=\"lucide-search\" href=\"/market/common/get-task-detail\">\n  Learn how to query task status and retrieve generation results\n</Card>\n\n::: tip[]\nFor production use, we recommend using the `callBackUrl` parameter to receive automatic notifications when generation completes, rather than polling the status endpoint.\n:::\n\n## Related Resources\n\n<CardGroup cols={2}>\n  <Card title=\"Market Overview\" icon=\"lucide-store\" href=\"/market/quickstart\">\n    Explore all available models\n  </Card>\n  <Card title=\"Common API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\">\n    Check credits and account usage\n  </Card>\n</CardGroup>",
          "operationId": "happyhorse-video-edit",
          "tags": [],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "model",
                    "input"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "description": "The model name to use for generation. Required field.\n\n- Must be `happyhorse/video-edit` for this endpoint",
                      "enum": [
                        "happyhorse/video-edit"
                      ],
                      "default": "happyhorse/video-edit",
                      "examples": [
                        "happyhorse/video-edit"
                      ]
                    },
                    "callBackUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "The URL to receive generation task completion updates. Optional but recommended for production use.\n\n- System will POST task status and results to this URL when generation completes\n- Callback includes generated content URLs and task information\n- Your callback endpoint should accept POST requests with JSON payload containing results\n- Alternatively, use the Get Task Details endpoint to poll task status\n- To ensure callback security, see [Webhook Verification Guide](/common-api/webhook-verification) for signature verification implementation",
                      "examples": [
                        "https://your-domain.com/api/callback"
                      ]
                    },
                    "input": {
                      "type": "object",
                      "description": "Input parameters for the generation task",
                      "properties": {
                        "prompt": {
                          "type": "string",
                          "description": "Required edit instruction describing the intended change (e.g., style transfer / local replacement). Up to 5,000 characters.",
                          "maxLength": 5000,
                          "examples": [
                            "Make the horse-headed humanoid character in the video wear the striped sweater from the image"
                          ]
                        },
                        "video_url": {
                          "type": "string",
                          "description": "URL of the input video (one video).\nVideo requirements:\nFormat: MP4, MOV (H.264 encoding recommended).\nDuration: 3–60 seconds.\nResolution: the longer side must not exceed 2,160 px; the shorter side must be at least 320 px.\nAspect ratio: 1:2.5–2.5:1.\nFile size: up to 100 MB.\nFrame rate: greater than 8 fps."
                        },
                        "reference_image": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Optional reference image URL list (0–5).\nImage requirements:\nFormat: JPEG, JPG, PNG, WEBP.\nResolution: both width and height must be at least 300 px.\nAspect ratio: 1:2.5–2.5:1.\nFile size: up to 10 MB.",
                          "maxItems": 5,
                          "minItems": 0
                        },
                        "resolution": {
                          "type": "string",
                          "description": "Output video resolution: 720p or 1080p (default).",
                          "enum": [
                            "720p",
                            "1080p"
                          ],
                          "default": "1080p",
                          "examples": [
                            "1080p"
                          ]
                        },
                        "audio_setting": {
                          "type": "string",
                          "description": "Audio handling: auto lets the model handle audio; origin keeps the input video's original audio where possible.",
                          "enum": [
                            "auto",
                            "origin"
                          ],
                          "default": "auto",
                          "examples": [
                            "auto"
                          ]
                        },
                        "seed": {
                          "type": "integer",
                          "description": "Random seed for reproducibility.",
                          "default": 0,
                          "minimum": 0,
                          "maximum": 2147483647
                        }
                      },
                      "required": [
                        "prompt",
                        "video_url"
                      ]
                    }
                  }
                },
                "example": {
                  "model": "happyhorse/video-edit",
                  "callBackUrl": "https://your-domain.com/api/callback",
                  "input": {
                    "prompt": "Make the horse-headed humanoid character in the video wear the striped sweater from the image",
                    "video_url": "https://example.com/your-video.mp4",
                    "reference_image": [
                      "https://example.com/your-image.png",
                      "https://example.com/your-image.png",
                      "https://example.com/your-image.png",
                      "https://example.com/your-image.png",
                      "https://example.com/your-image.png"
                    ],
                    "resolution": "1080p",
                    "audio_setting": "auto",
                    "seed": 1764574909
                  }
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Request successful",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/response%20not%20with%20recordId"
                      }
                    ]
                  },
                  "example": {
                    "code": 200,
                    "msg": "success",
                    "data": {
                      "taskId": "task_bytedance_1765186743319"
                    }
                  }
                }
              },
              "headers": {}
            }
          },
          "security": [],
          "callbacks": {
            "videoTaskCompleted": {
              "{request.body#/callBackUrl}": {
                "post": {
                  "description": "The system sends this callback when the `happyhorse/video-edit` task succeeds or fails.",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "required": [
                            "code",
                            "msg",
                            "data"
                          ],
                          "properties": {
                            "code": {
                              "type": "integer",
                              "description": "Unified callback code: 200 for success, 501 for failure.",
                              "enum": [
                                200,
                                501
                              ]
                            },
                            "msg": {
                              "type": "string",
                              "description": "Unified callback message.",
                              "enum": [
                                "Playground task completed successfully.",
                                "Playground task failed."
                              ]
                            },
                            "data": {
                              "type": "object",
                              "required": [
                                "taskId",
                                "model",
                                "state",
                                "param"
                              ],
                              "properties": {
                                "taskId": {
                                  "type": "string",
                                  "description": "The unique task identifier."
                                },
                                "model": {
                                  "type": "string",
                                  "description": "The model used for the task.",
                                  "enum": [
                                    "happyhorse/video-edit"
                                  ]
                                },
                                "state": {
                                  "type": "string",
                                  "description": "Terminal task state.",
                                  "enum": [
                                    "success",
                                    "fail"
                                  ]
                                },
                                "param": {
                                  "type": "string",
                                  "description": "JSON string containing the submitted task parameters."
                                },
                                "resultJson": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "JSON string containing resultUrls, firstFrameUrl, lastFrameUrl, or resultObject when successful. Present only when state is success."
                                },
                                "failCode": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Failure code, a numeric string such as \"400\" or \"500\". Present only when state is fail."
                                },
                                "failMsg": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Failure reason. Present only when state is fail."
                                },
                                "costTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Processing time in seconds. Present on both success and failure callbacks."
                                },
                                "completeTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task completion timestamp."
                                },
                                "createTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task creation timestamp."
                                },
                                "updateTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Use completeTime as the completion time; updateTime may equal createTime."
                                },
                                "creditsConsumed": {
                                  "type": "number",
                                  "description": "Credits consumed by the task; 0 for failed tasks."
                                }
                              }
                            }
                          }
                        },
                        "examples": {
                          "success": {
                            "summary": "Task completed successfully",
                            "value": {
                              "code": 200,
                              "msg": "Playground task completed successfully.",
                              "data": {
                                "taskId": "task_example_video_webhook_001",
                                "model": "happyhorse/video-edit",
                                "state": "success",
                                "param": "{\"input\":\"{\\\"prompt\\\":\\\"Make the horse-headed humanoid character in the video wear the striped sweater from the image\\\",\\\"video_url\\\":\\\"https://example.com/input-video.mp4\\\",\\\"reference_image\\\":[\\\"https://example.com/input-image.jpg\\\"],\\\"resolution\\\":\\\"1080p\\\",\\\"audio_setting\\\":\\\"auto\\\",\\\"seed\\\":1764574909}\",\"callBackUrl\":\"https://example.com/callback\",\"model\":\"happyhorse/video-edit\"}",
                                "resultJson": "{\"resultUrls\":[\"https://example.com/generated-video.mp4\"]}",
                                "costTime": 12,
                                "completeTime": 1234567890,
                                "createTime": 1234560000,
                                "updateTime": 1234567890,
                                "creditsConsumed": 1.23
                              }
                            }
                          },
                          "failure": {
                            "summary": "Task failed",
                            "value": {
                              "code": 501,
                              "msg": "Playground task failed.",
                              "data": {
                                "taskId": "task_example_video_webhook_001",
                                "model": "happyhorse/video-edit",
                                "state": "fail",
                                "param": "{\"input\":\"{\\\"prompt\\\":\\\"Make the horse-headed humanoid character in the video wear the striped sweater from the image\\\",\\\"video_url\\\":\\\"https://example.com/input-video.mp4\\\",\\\"reference_image\\\":[\\\"https://example.com/input-image.jpg\\\"],\\\"resolution\\\":\\\"1080p\\\",\\\"audio_setting\\\":\\\"auto\\\",\\\"seed\\\":1764574909}\",\"callBackUrl\":\"https://example.com/callback\",\"model\":\"happyhorse/video-edit\"}",
                                "failCode": "400",
                                "failMsg": "<error detail>",
                                "costTime": 12,
                                "creditsConsumed": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "responses": {
                    "200": {
                      "description": "Callback received successfully.",
                      "content": {
                        "application/json": {
                          "schema": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "integer",
                                "example": 200
                              },
                              "msg": {
                                "type": "string",
                                "example": "success"
                              }
                            }
                          },
                          "example": {
                            "code": 200,
                            "msg": "success"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "webhooks": {},
    "components": {
      "schemas": {
        "response not with recordId": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "description": "Status code of the request. The HTTP status is 200 even when the request fails, so always check this field: 200 means success; any other value means the request failed and msg describes the reason. Common values: 401 invalid or missing API key; 402 insufficient credits; 429 rate limit exceeded; 422 or 500 the request could not be processed (read msg and check your parameters before retrying).",
              "enum": [
                200,
                401,
                402,
                404,
                422,
                429,
                433,
                455,
                500,
                501,
                505
              ]
            },
            "msg": {
              "type": "string",
              "description": "Response message, error description upon failure",
              "examples": [
                "success"
              ]
            },
            "data": {
              "type": "object",
              "required": [
                "taskId"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "description": "The task ID can be used with the \"Get Task Details\" endpoint to query the task status.",
                  "examples": [
                    "dc1928bfcbc77cb6c85f3359a9c718b3"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {},
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "API Key",
          "description": "All API requests require a Bearer Token. Add the header `Authorization: Bearer YOUR_API_KEY` to authenticate requests."
        }
      }
    },
    "servers": [
      {
        "url": "https://api.kie.ai",
        "description": "正式环境"
      }
    ],
    "security": [
      {
        "BearerAuth": []
      }
    ]
  }
}
