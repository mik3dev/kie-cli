                            },
                            "schema": {
                              "type": "object",
                              "description": "The JSON Schema the answer must follow. Required when `type` is `json_schema`.",
                              "properties": {}
                            },
                            "strict": {
                              "type": "boolean",
                              "description": "Whether to validate the answer strictly against the schema. Only applies to `json_schema`."
                            }
                          },
                          "required": [
                            "type"
                          ]
                        }
                      },
                      "required": [
                        "format"
                      ]
