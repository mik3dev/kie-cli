                          },
                          "description": {
                            "type": "string",
                            "description": "What the function does. Helps the model decide when to call it."
                          },
                          "parameters": {
                            "type": "object",
                            "description": "Function parameter definition, as a JSON Schema object.",
                            "properties": {}
                          }
                        },
                        "required": [
                          "type",
                          "name",
                          "parameters"
                        ]
                      }
                    },
                    "tool_choice": {
                      "description": "Tool selection behavior. When function tools are configured in `tools`, set this to `auto` so the model can decide when to call them. Use `required` to force a call, or an object to pin one specific function. Defaults to `none` when `tools` is absent.",
                      "oneOf": [
                        {
                          "type": "string",
                          "description": "A preset selection strategy.",
                          "enum": [
                            "none",
                            "auto",
                            "required"
                          ]
                        },
                        {
                          "type": "object",
                          "description": "Pin one specific function.",
                          "properties": {
                            "type": {
                              "type": "string",
                              "description": "Tool type. Fixed as `function`.",
                              "enum": [
                                "function"
                              ]
                            },
                            "name": {
                              "type": "string",
                              "description": "Function name. Returned verbatim when the model calls it."
                            }
                          },
                          "required": [
                            "type",
                            "name"
                          ]
                        }
                      ]
                    },
                    "text": {
                      "type": "object",
                      "description": "Output format configuration.",
                      "properties": {
                        "format": {
                          "type": "object",
                          "description": "The format the answer must follow.",
                          "properties": {
                            "type": {
                              "type": "string",
                              "description": "Format type. `text` returns plain text, `json_object` constrains the answer to JSON, and `json_schema` validates it against a schema of your own.",
                              "enum": [
                                "text",
                                "json_object",
                                "json_schema"
                              ]
