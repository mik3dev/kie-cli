{
  "model": "bytedance/seedance-2-5-draft",
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "kie.ai",
      "description": "kie.ai API 文档",
      "version": "1.0.0",
      "contact": {
        "name": "技术支持",
        "email": "support@kie.ai"
      }
    },
    "tags": [],
    "paths": {
      "/api/v1/jobs/createTask": {
        "post": {
          "summary": "Bytedance Seedance 2.5 Draft",
          "deprecated": false,
          "description": "## Query Task Status\n\nAfter submitting a task, use the unified query endpoint to check progress and retrieve results:\n\n<Card title=\"Get Task Details\" icon=\"lucide-search\" href=\"/market/common/get-task-detail\">\n  Learn how to query task status and retrieve generation results\n</Card>\n\n::: tip[]\nIn production environments, it is recommended to use the callBackUrl parameter to receive automatic notifications upon completion, rather than polling the status API.\n::: \n\n\n<CardGroup cols={2}>\n  <Card title=\"Market Overview\" icon=\"lucide-store\" href=\"/market/quickstart\">\n    Explore all available models\n  </Card>\n  <Card title=\"Common API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\">\n    Check credits and account usage\n  </Card>\n</CardGroup>\n",
          "operationId": "bytedance-seedance-2-5-draft",
          "tags": [],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "model",
                    "input"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "description": "The model name to use for generation. Required field.\n\n- Must be `bytedance/seedance-2-5-draft` for this endpoint",
                      "enum": [
                        "bytedance/seedance-2-5-draft"
                      ],
                      "default": "bytedance/seedance-2-5-draft",
                      "examples": [
                        "bytedance/seedance-2-5-draft"
                      ]
                    },
                    "callBackUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "The URL to receive generation task completion updates. Optional but recommended for production use.\n\n- System will POST task status and results to this URL when generation completes\n- Callback includes generated content URLs and task information\n- Your callback endpoint should accept POST requests with JSON payload containing results\n- Alternatively, use the Get Task Details endpoint to poll task status\n- To ensure callback security, see [Webhook Verification Guide](/common-api/webhook-verification) for signature verification implementation",
                      "examples": [
                        "https://your-domain.com/api/callback"
                      ]
                    },
                    "input": {
                      "type": "object",
                      "description": "Input parameters for the generation task",
                      "properties": {
                        "draft_task_id": {
                          "type": "string",
                          "description": "task id from model seedance 2.5 generation task. Valid for 7 days from draft creation."
                        },
                        "resolution": {
                          "type": "string",
                          "enum": [
                            "1080p"
                          ],
                          "description": "output video resolution."
                        },
                        "output_format": {
                          "type": "string",
                          "description": "ouput video format.",
                          "enum": [
                            "mp4",
                            "mov"
                          ]
                        },
                        "return_last_frame": {
                          "type": "boolean",
                          "description": "Whether to also return the last frame of the generated video as a JPEG (in resultJson.lastFrameUrl). Default false.",
                          "default": false
                        },
                        "nsfw_checker": {
                          "type": "boolean",
                          "description": "Defaults to false. When false, no additional content filtering is applied and results are returned directly by the model."
                        }
                      },
                      "required": [
                        "draft_task_id",
                        "resolution"
                      ]
                    }
                  }
                },
                "example": {
                  "model": "bytedance/seedance-2-5-draft",
                  "callBackUrl": "https://your-domain.com/api/callback",
                  "input": {
                    "draft_task_id": "37",
                    "resolution": "1080p",
                    "output_format": "mov",
                    "nsfw_checker": true
                  }
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Request successful",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/response%20not%20with%20recordId"
                      }
                    ]
                  },
                  "example": {
                    "code": 200,
                    "msg": "success",
                    "data": {
                      "taskId": "task_bytedance_1765186743319"
                    }
                  }
                }
              },
              "headers": {}
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ],
          "callbacks": {
            "videoTaskCompleted": {
              "{request.body#/callBackUrl}": {
                "post": {
                  "description": "The system sends this callback when the `bytedance/seedance-2-5-draft` task succeeds or fails.",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "required": [
                            "code",
                            "msg",
                            "data"
                          ],
                          "properties": {
                            "code": {
                              "type": "integer",
                              "description": "Unified callback code: 200 for success, 501 for failure.",
                              "enum": [
                                200,
                                501
                              ]
                            },
                            "msg": {
                              "type": "string",
                              "description": "Unified callback message.",
                              "enum": [
                                "Playground task completed successfully.",
                                "Playground task failed."
                              ]
                            },
                            "data": {
                              "type": "object",
                              "required": [
                                "taskId",
                                "model",
                                "state",
                                "param"
                              ],
                              "properties": {
                                "taskId": {
                                  "type": "string",
                                  "description": "The unique task identifier."
                                },
                                "model": {
                                  "type": "string",
                                  "description": "The model used for the task.",
                                  "enum": [
                                    "bytedance/seedance-2-5-draft"
                                  ]
                                },
                                "state": {
                                  "type": "string",
                                  "description": "Terminal task state.",
                                  "enum": [
                                    "success",
                                    "fail"
                                  ]
                                },
                                "param": {
                                  "type": "string",
                                  "description": "JSON string containing the submitted task parameters."
                                },
                                "resultJson": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "JSON string. On success it contains resultUrls; when return_last_frame is true it also contains lastFrameUrl (JPEG). Present only when state is success."
                                },
                                "failCode": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Failure code, a numeric string such as \"400\" or \"500\". Present only when state is fail."
                                },
                                "failMsg": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Failure reason. Present only when state is fail."
                                },
                                "costTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Processing time in seconds. Present on both success and failure callbacks."
                                },
                                "completeTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task completion timestamp."
                                },
                                "createTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task creation timestamp."
                                },
                                "updateTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Use completeTime as the completion time; updateTime may equal createTime."
                                },
                                "creditsConsumed": {
                                  "type": "number",
                                  "description": "Credits consumed by the task; 0 for failed tasks."
                                }
                              }
                            }
                          }
                        },
                        "examples": {
                          "success": {
                            "summary": "Task completed successfully",
                            "value": {
                              "code": 200,
                              "msg": "Playground task completed successfully.",
                              "data": {
                                "taskId": "task_example_video_webhook_001",
                                "model": "bytedance/seedance-2-5-draft",
                                "state": "success",
                                "param": "{\"input\":\"{}\",\"callBackUrl\":\"https://example.com/callback\",\"model\":\"bytedance/seedance-2-5-draft\"}",
                                "resultJson": "{\"resultUrls\":[\"https://example.com/generated-video.mp4\"],\"lastFrameUrl\":[\"https://example.com/last-frame.jpg\"]}",
                                "costTime": 12,
                                "completeTime": 1234567890,
                                "createTime": 1234560000,
                                "updateTime": 1234567890,
                                "creditsConsumed": 1.23
                              }
                            }
                          },
                          "failure": {
                            "summary": "Task failed",
                            "value": {
                              "code": 501,
                              "msg": "Playground task failed.",
                              "data": {
                                "taskId": "task_example_video_webhook_001",
                                "model": "bytedance/seedance-2-5-draft",
                                "state": "fail",
                                "param": "{\"input\":\"{}\",\"callBackUrl\":\"https://example.com/callback\",\"model\":\"bytedance/seedance-2-5-draft\"}",
                                "failCode": "400",
                                "failMsg": "<error detail>",
                                "costTime": 12,
                                "creditsConsumed": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "responses": {
                    "200": {
                      "description": "Callback received successfully.",
                      "content": {
                        "application/json": {
                          "schema": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "integer",
                                "example": 200
                              },
                              "msg": {
                                "type": "string",
                                "example": "success"
                              }
                            }
                          },
                          "example": {
                            "code": 200,
                            "msg": "success"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "webhooks": {},
    "components": {
      "schemas": {
        "response not with recordId": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "description": "Status code of the request. The HTTP status is 200 even when the request fails, so always check this field: 200 means success; any other value means the request failed and msg describes the reason. Common values: 401 invalid or missing API key; 402 insufficient credits; 429 rate limit exceeded; 422 or 500 the request could not be processed (read msg and check your parameters before retrying).",
              "enum": [
                200,
                401,
                402,
                404,
                422,
                429,
                433,
                455,
                500,
                501,
                505
              ]
            },
            "msg": {
              "type": "string",
              "description": "Response message, error description upon failure",
              "examples": [
                "success"
              ]
            },
            "data": {
              "type": "object",
              "required": [
                "taskId"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "description": "The task ID can be used with the \"Get Task Details\" endpoint to query the task status.",
                  "examples": [
                    "dc1928bfcbc77cb6c85f3359a9c718b3"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {},
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "API Key",
          "description": "All API requests require a Bearer Token. Add the header `Authorization: Bearer YOUR_API_KEY` to authenticate requests."
        }
      }
    },
    "servers": [
      {
        "url": "https://api.kie.ai",
        "description": "正式环境"
      }
    ],
    "security": [
      {
        "BearerAuth": []
      }
    ]
  }
}
