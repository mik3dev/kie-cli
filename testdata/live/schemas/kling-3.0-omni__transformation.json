    "paths": {
      "/api/v1/jobs/createTask": {
        "post": {
          "summary": "Kling 3.0 Omni Transformation",
          "deprecated": false,
          "description": "## Query Task Status\n\nAfter submitting a task, you can check the task progress and retrieve generation results via the unified query endpoint:\n\n<Card title=\"Get Task Details\" icon=\"lucide-search\" href=\"/market/common/get-task-detail\">\n  Learn how to query task status and obtain generation results\n</Card>\n\n::: tip[]\nFor production use, we recommend using the `callBackUrl` parameter to receive automatic notifications when generation completes, rather than polling the status endpoint.\n:::\n\n## Related Resources\n\n<CardGroup cols={2}>\n  <Card title=\"Market Overview\" icon=\"lucide-store\" href=\"/market/quickstart\">\n    Browse all available models\n  </Card>\n  <Card title=\"Common API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\">\n    Check account credits and usage status\n  </Card>\n</CardGroup>",
          "operationId": "kling-3.0-omni-transformation",
          "tags": [],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "model",
                    "input"
                  ],
                  "properties": {
                    "model": {
                      "type": "string",
                      "enum": [
                        "kling-3.0-omni/transformation"
                      ],
                      "default": "kling-3.0-omni/transformation",
                      "description": "The name of the model used to generate the task. This field is required.\n\n- This endpoint requires the `kling-3.0-omni/transformation` model",
                      "examples": [
                        "kling-3.0-omni/transformation"
                      ]
                    },
                    "callBackUrl": {
                      "type": "string",
                      "format": "uri",
                      "description": "The URL to receive generation task completion updates. Optional but recommended for production use.\n\n- System will POST task status and results to this URL when generation completes\n- Callback includes generated content URLs and task information\n- Your callback endpoint should accept POST requests with JSON payload containing results\n- Alternatively, use the Get Task Details endpoint to poll task status\n- To ensure callback security, see [Webhook Verification Guide](/common-api/webhook-verification) for signature verification implementation",
                      "examples": [
                        "https://your-domain.com/api/callback"
                      ]
                    },
                    "input": {
                      "type": "object",
                      "description": "Input parameters for the generation task.",
                      "oneOf": [
                        {
                          "title": "Video Input Only",
                          "type": "object",
                          "required": [
                            "prompt",
                            "video_urls"
                          ],
                          "properties": {
                            "prompt": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 3072,
                              "description": "Video description. It must not be empty after leading and trailing whitespace is removed. Maximum length: 3,072 characters.",
                              "examples": [
                                "Transform the input video into a cinematic night scene while preserving the character movements from the original video."
                              ]
                            },
                            "video_urls": {
                              "type": "array",
                              "description": "Array of video URLs. Exactly 1 video is required. HTTP, HTTPS, and OSS URLs are supported. Videos must be in MP4 or MOV format; each file must not exceed 200 MB; duration must be between 3 and 15.5 seconds; width and height must each be between 700 and 4,553 px; total pixels must not exceed 8,294,400; the aspect ratio must be between 0.4 and 2; and the frame rate must be between 24 and 60 fps.",
                              "minItems": 1,
                              "maxItems": 1,
                              "items": {
                                "type": "string",
                                "format": "uri",
                                "pattern": "^(https?|oss)://"
                              },
                              "examples": [
                                [
                                  "https://example.com/source-video.mp4"
                                ]
                              ]
                            },
                            "resolution": {
                              "type": "string",
                              "description": "Video resolution. `720p` outputs a 720p video, `1080p` outputs a 1080p video, and `4k` outputs a 4K video.",
                              "enum": [
                                "720p",
                                "1080p",
                                "4k"
                              ],
                              "default": "720p",
                              "examples": [
                                "720p"
                              ]
                            },
                            "aspect_ratio": {
                              "type": "string",
                              "description": "Video aspect ratio. Only `auto` can be used with video-only input.",
                              "enum": [
                                "auto"
                              ],
                              "default": "auto",
                              "examples": [
                                "auto"
                              ]
                            },
                            "audio": {
                              "type": "boolean",
                              "description": "No audio is generated when a video is provided; set false.",
                              "enum": [
                                false,
                                true
