{
  "model": "qwen3/text-to-image",
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "kie.ai",
      "description": "kie.ai API 文档",
      "version": "1.0.0",
      "contact": {
        "name": "技术支持",
        "email": "support@kie.ai"
      }
    },
    "tags": [],
    "paths": {
      "/api/v1/jobs/createTask": {
        "post": {
          "summary": "Qwen3 Text to Image",
          "deprecated": false,
          "description": "## Create Task\n\nUse this endpoint to create a new text-to-image generation task from a positive prompt.\n\n- Supported resolutions: `1K` and `2K`.\n- Supported image sizes: `1:1`, `3:2`, `2:3`, `4:3`, `3:4`, `16:9`, `9:16`, and `21:9`. \n- Supported output formats: `png` and `jpeg`.\n- Intelligent prompt rewriting is enabled by default to improve results from simple prompts.\n\n<Card title=\"Get Task Details\" icon=\"lucide-search\" href=\"/market/common/get-task-detail\">\n  After submission, use the unified query endpoint to check task progress and retrieve results\n</Card>\n\n::: tip[]\nFor production use, we recommend providing the `callBackUrl` parameter so your service can receive completion notifications instead of polling for task status.\n:::\n\n## Related Resources\n\n<CardGroup cols={2}>\n  <Card title=\"Model Marketplace\" icon=\"lucide-store\" href=\"/market/quickstart\">\n    Explore all available models and capabilities\n  </Card>\n  <Card title=\"Common API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\">\n    Check account credits and usage\n  </Card>\n</CardGroup>",
          "operationId": "qwen3-text-to-image",
          "tags": [],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "model": {
                      "default": "qwen3/text-to-image",
                      "description": "The model name used for generation. This field is required. This endpoint must use the `qwen3/text-to-image` model.",
                      "enum": [
                        "qwen3/text-to-image"
                      ],
                      "examples": [
                        "qwen3/text-to-image"
                      ],
                      "type": "string"
                    },
                    "callBackUrl": {
                      "description": "Callback URL for task completion notifications. Optional parameter. If provided, the system will send a POST request to this URL when the task completes, whether it succeeds or fails. If omitted, no callback notification will be sent.",
                      "examples": [
                        "https://your-domain.com/api/callback"
                      ],
                      "format": "uri",
                      "type": "string"
                    },
                    "input": {
                      "description": "Input parameters for the text-to-image generation task.",
                      "properties": {
                        "prompt": {
                          "description": "The positive prompt that describes the image content, style, and composition you want to generate or edit. Both Chinese and English are supported.",
                          "examples": [
                            "A futuristic city at sunset, cinematic lighting, ultra detailed."
                          ],
                          "maxLength": 5000,
                          "minLength": 1,
                          "type": "string"
                        },
                        "resolution": {
                          "description": "The output image resolution.",
                          "enum": [
                            "1K",
                            "2K"
                          ],
                          "examples": [
                            "1K"
                          ],
                          "type": "string"
                        },
                        "image_size": {
                          "default": "16:9",
                          "description": "The output image size. ",
                          "enum": [
                            "1:1",
                            "3:2",
                            "2:3",
                            "4:3",
                            "3:4",
                            "16:9",
                            "9:16",
                            "21:9"
                          ],
                          "examples": [
                            "1:1"
                          ],
                          "type": "string"
                        },
                        "output_format": {
                          "description": "Output format: png or jpeg. Set this field explicitly.",
                          "enum": [
                            "png",
                            "jpeg"
                          ],
                          "examples": [
                            "png"
                          ],
                          "type": "string"
                        },
                        "prompt_extend": {
                          "default": true,
                          "description": "Whether to enable intelligent prompt rewriting. Default: true (recommended). When enabled, the model optimizes the positive prompt, which significantly improves results for simple descriptions.",
                          "examples": [
                            true
                          ],
                          "type": "boolean"
                        },
                        "negative_prompt": {
                          "description": "The negative prompt that describes content you do not want to appear in the image.",
                          "examples": [
                            "blurry, low quality, distorted"
                          ],
                          "maxLength": 5000,
                          "minLength": 0,
                          "type": "string"
                        },
                        "seed": {
                          "description": "Random seed, 0–2147483647. If omitted, a random seed is used.",
                          "examples": [
                            1
                          ],
                          "maximum": 2147483647,
                          "minimum": 0,
                          "type": "integer"
                        },
                        "nsfw_checker": {
                          "default": false,
                          "description": "Whether to enable content filtering. Optional. Defaults to false. When set to false, content filtering is disabled and all results are returned directly by the model. Note: Content filtering cannot guarantee that all inappropriate content will be detected. If the filtering results do not meet your requirements, you must implement additional content moderation measures.",
                          "examples": [
                            false
                          ],
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "prompt"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "model",
                    "input"
                  ],
                  "type": "object"
                },
                "example": {
                  "model": "qwen3/text-to-image",
                  "callBackUrl": "https://your-domain.com/api/callback",
                  "input": {
                    "prompt": "A futuristic city at sunset, cinematic lighting, ultra detailed.",
                    "resolution": "1K",
                    "image_size": "1:1",
                    "output_format": "png",
                    "prompt_extend": true,
                    "nsfw_checker": false,
                    "negative_prompt": "blurry, low quality, distorted",
                    "seed": 1
                  }
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Request successful",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/response%20not%20with%20recordId"
                      }
                    ]
                  },
                  "example": {
                    "code": 200,
                    "msg": "success",
                    "data": {
                      "taskId": "task_qwen3_1765180586443"
                    }
                  }
                }
              },
              "headers": {}
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ],
          "callbacks": {
            "onImageGenerated": {
              "{$request.body#/callBackUrl}": {
                "post": {
                  "summary": "Image Generation Callback",
                  "description": "Sent when the task succeeds or fails.",
                  "requestBody": {
                    "required": true,
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "integer",
                              "description": "200: success. 501: failure; see data.failCode and data.failMsg.",
                              "enum": [
                                200,
                                501
                              ]
                            },
                            "msg": {
                              "type": "string",
                              "description": "Status message",
                              "example": "Playground task completed successfully."
                            },
                            "data": {
                              "type": "object",
                              "properties": {
                                "completeTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task completion time, represented as a Unix timestamp in milliseconds",
                                  "example": 1786435794000
                                },
                                "costTime": {
                                  "type": "integer",
                                  "description": "Processing time in seconds. Present on both success and failure callbacks.",
                                  "example": 50
                                },
                                "createTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Task creation time, represented as a Unix timestamp in milliseconds",
                                  "example": 1786435744000
                                },
                                "creditsConsumed": {
                                  "type": "number",
                                  "format": "double",
                                  "description": "Credits consumed by the task; 0 for failed tasks.",
                                  "example": 4.8
                                },
                                "model": {
                                  "type": "string",
                                  "description": "Image generation model used for the task",
                                  "example": "qwen3/text-to-image"
                                },
                                "param": {
                                  "type": "string",
                                  "description": "Parameters submitted when creating the task, in JSON string format",
                                  "example": "{\"input\":\"{\\\"output_format\\\":\\\"png\\\",\\\"seed\\\":1,\\\"image_size\\\":\\\"1:1\\\",\\\"prompt_extend\\\":true,\\\"negative_prompt\\\":\\\"blurry, low quality, distorted\\\",\\\"prompt\\\":\\\"A futuristic city at sunset, with cinematic lighting and richdetails.\\\",\\\"resolution\\\":\\\"1K\\\",\\\"nsfw_checker\\\":false}\",\"callBackUrl\":\"https://your-domain.com/api/callback\",\"model\":\"qwen3/text-to-image\"}"
                                },
                                "resultJson": {
                                  "type": "string",
                                  "description": "Image generation result in JSON string format. resultUrls contains the list of generated image URLs. Present only when state is success.",
                                  "example": "{\"resultUrls\":[\"https://tempfile.aiquickdraw.com/qwen3/1786435792390-gpr7gwwa38a.png\"]}"
                                },
                                "state": {
                                  "type": "string",
                                  "description": "Task status",
                                  "enum": [
                                    "success",
                                    "fail"
                                  ],
                                  "example": "success"
                                },
                                "taskId": {
                                  "type": "string",
                                  "description": "Task ID",
                                  "example": "fe5c31fed1af328835a3a34f98ed08f2"
                                },
                                "updateTime": {
                                  "type": "integer",
                                  "format": "int64",
                                  "description": "Use completeTime as the completion time; updateTime may equal createTime.",
                                  "example": 1786435794000
                                },
                                "failCode": {
                                  "type": "string",
                                  "description": "Failure code, a numeric string such as \"400\" or \"500\". Present only when state is fail.",
                                  "example": "500"
                                },
                                "failMsg": {
                                  "type": "string",
                                  "description": "Failure reason. Present only when state is fail.",
                                  "example": "<error detail>"
                                }
                              }
                            }
                          }
                        },
                        "examples": {
                          "success": {
                            "summary": "Success",
                            "value": {
                              "code": 200,
                              "msg": "Playground task completed successfully.",
                              "data": {
                                "taskId": "fe5c31fed1af328835a3a34f98ed08f2",
                                "model": "qwen3/text-to-image",
                                "state": "success",
                                "param": "{\"input\":\"{\\\"output_format\\\":\\\"png\\\",\\\"seed\\\":1,\\\"image_size\\\":\\\"1:1\\\",\\\"prompt_extend\\\":true,\\\"negative_prompt\\\":\\\"blurry, low quality, distorted\\\",\\\"prompt\\\":\\\"A futuristic city at sunset, with cinematic lighting and richdetails.\\\",\\\"resolution\\\":\\\"1K\\\",\\\"nsfw_checker\\\":false}\",\"callBackUrl\":\"https://your-domain.com/api/callback\",\"model\":\"qwen3/text-to-image\"}",
                                "resultJson": "{\"resultUrls\":[\"https://tempfile.aiquickdraw.com/qwen3/1786435792390-gpr7gwwa38a.png\"]}",
                                "completeTime": 1786435794000,
                                "createTime": 1786435744000,
                                "costTime": 50,
                                "creditsConsumed": 4.8,
                                "updateTime": 1786435794000
                              }
                            }
                          },
                          "failure": {
                            "summary": "Failure",
                            "value": {
                              "code": 501,
                              "msg": "Playground task failed.",
                              "data": {
                                "taskId": "fe5c31fed1af328835a3a34f98ed08f2",
                                "model": "qwen3/text-to-image",
                                "state": "fail",
                                "param": "{\"input\":\"{\\\"output_format\\\":\\\"png\\\",\\\"seed\\\":1,\\\"image_size\\\":\\\"1:1\\\",\\\"prompt_extend\\\":true,\\\"negative_prompt\\\":\\\"blurry, low quality, distorted\\\",\\\"prompt\\\":\\\"A futuristic city at sunset, with cinematic lighting and richdetails.\\\",\\\"resolution\\\":\\\"1K\\\",\\\"nsfw_checker\\\":false}\",\"callBackUrl\":\"https://your-domain.com/api/callback\",\"model\":\"qwen3/text-to-image\"}",
                                "failCode": "500",
                                "failMsg": "<error detail>",
                                "completeTime": 1786435794000,
                                "createTime": 1786435744000,
                                "costTime": 50,
                                "creditsConsumed": 0,
                                "updateTime": 1786435794000
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "responses": {
                    "200": {
                      "description": "Callback received successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "webhooks": {},
    "components": {
      "schemas": {
        "response not with recordId": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "code": {
              "type": "integer",
              "description": "Status code of the request. The HTTP status is 200 even when the request fails, so always check this field: 200 means success; any other value means the request failed and msg describes the reason. Common values: 401 invalid or missing API key; 402 insufficient credits; 429 rate limit exceeded; 422 or 500 the request could not be processed (read msg and check your parameters before retrying).",
              "enum": [
                200,
                401,
                402,
                404,
                422,
                429,
                433,
                455,
                500,
                501,
                505
              ]
            },
            "msg": {
              "type": "string",
              "description": "Response message, error description upon failure",
              "examples": [
                "success"
              ]
            },
            "data": {
              "type": "object",
              "required": [
                "taskId"
              ],
              "properties": {
                "taskId": {
                  "type": "string",
                  "description": "The task ID can be used with the \"Get Task Details\" endpoint to query the task status.",
                  "examples": [
                    "dc1928bfcbc77cb6c85f3359a9c718b3"
                  ]
                }
              }
            }
          }
        }
      },
      "responses": {},
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "API Key",
          "description": "All API requests require a Bearer Token. Add the header `Authorization: Bearer YOUR_API_KEY` to authenticate requests."
        }
      }
    },
    "servers": [
      {
        "url": "https://api.kie.ai",
        "description": "正式环境"
      }
    ],
    "security": [
      {
        "BearerAuth": []
      }
    ]
  }
}
