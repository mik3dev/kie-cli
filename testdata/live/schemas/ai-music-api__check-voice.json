  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "kie.ai",
      "description": "kie.ai API 文档",
      "version": "1.0.0",
      "contact": {
        "name": "技术支持",
        "email": "support@kie.ai"
      }
    },
    "tags": [
      {
        "name": "Suno API/voice"
      }
    ],
    "paths": {
      "/api/v1/jobs/createTask": {
        "post": {
          "summary": "Suno Voice Check Availability API",
          "deprecated": false,
          "description": ":::warning Document updated\nIf you have already completed the integration process previously, you can still access the old version document at: Old version address (https://docs.kie.ai/old-model/suno-api/suno-voice-check-voice)\n:::\nCheck whether a generated Suno custom voice is available.\n\nSynchronous: the result is returned in data.isAvailable; no task is created. task_id: the taskId returned by Create Custom Voice.\n\n:::tip\nThis endpoint is free.\n:::\n\nRelated resources\n\n<CardGroup cols={2}>\n  <Card title=\"Generate Voice\" icon=\"lucide-mic\" href=\"/suno-api/suno-voice-generate\"> Create a custom voice from verification audio </Card>\n  <Card title=\"General API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\"> View account credits and usage </Card>\n</CardGroup>\n",
          "operationId": "suno-voice-check-voice",
          "tags": [
            "Suno API/voice"
          ],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "description": "The model name to use for generation. Required field.",
                      "examples": [
                        "ai-music-api/check-voice"
                      ]
                    },
                    "input": {
                      "type": "object",
                      "description": "Input parameters for the generation task",
                      "properties": {
                        "task_id": {
                          "description": "Task ID that needs to be checked",
                          "type": "string"
                        }
                      },
                      "required": [
                        "task_id"
                      ]
                    }
                  },
                  "required": [
                    "model",
                    "input"
                  ]
                },
                "example": {
                  "model": "ai-music-api/check-voice",
                  "input": {
                    "task_id": "dsaa43209wejf0925904j29140sfs"
                  }
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Request successful.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer",
                        "description": "Status code of the request. The HTTP status is 200 even when the request fails, so always check this field: 200 means success; any other value means the request failed and msg describes the reason. Common values: 401 invalid or missing API key; 402 insufficient credits; 429 rate limit exceeded; 422 or 500 the request could not be processed (read msg and check your parameters before retrying)."
                      },
                      "msg": {
                        "type": "string"
                      },
                      "data": {
                        "type": "object",
                        "properties": {
                          "isAvailable": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "isAvailable"
                        ]
                      }
                    },
                    "required": [
                      "code",
                      "msg",
                      "data"
                    ]
                  },
                  "example": {
                    "code": 200,
                    "msg": "success",
                    "data": {
                      "isAvailable": true
                    }
                  }
                }
              },
              "headers": {}
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      }
    },
    "webhooks": {},
    "components": {
      "schemas": {},
      "responses": {},
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "API Key",
          "description": "All API requests require a Bearer Token. Add the header `Authorization: Bearer YOUR_API_KEY` to authenticate requests."
        }
      }
    },
    "servers": [
      {
        "url": "https://api.kie.ai",
        "description": "正式环境"
      }
    ],
