{
  "model": "gemini-omni-character",
  "openapi": {
    "openapi": "3.1.0",
    "info": {
      "title": "kie.ai",
      "description": "kie.ai API 文档",
      "version": "1.0.0",
      "contact": {
        "name": "技术支持",
        "email": "support@kie.ai"
      }
    },
    "tags": [],
    "paths": {
      "/api/v1/omni/character/create": {
        "post": {
          "summary": "Gemini Omni Character",
          "deprecated": false,
          "description": "- image_urls supports 1–2 images (index 0 portrait, index 1 optional full-body), each up to 20MB.\n- `audio_ids` must come from the `gemini-omni-audio` endpoint\n\n## Create Task\n\nUse this endpoint to create a new character.\n\n:::tip\nThis endpoint is free.\n:::\n\n## Related Resources\n\n<CardGroup cols={2}>\n  <Card title=\"Model Marketplace\" icon=\"lucide-store\" href=\"/market/quickstart\">\n    Explore all available models and capabilities\n  </Card>\n  <Card title=\"Common API\" icon=\"lucide-cog\" href=\"/common-api/get-account-credits\">\n    Check account credits and usage\n  </Card>\n</CardGroup>",
          "operationId": "gemini-omni-character",
          "tags": [],
          "parameters": [],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "descriptions",
                    "image_urls"
                  ],
                  "properties": {
                    "descriptions": {
                      "type": "string",
                      "description": "Character description used to define the appearance, identity, style, clothing, or personality of the character.",
                      "examples": [
                        "A young female character with short silver hair and a futuristic utility jacket, calm, agile, and strongly cyberpunk in style."
                      ]
                    },
                    "image_urls": {
                      "type": "array",
                      "maxItems": 2,
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "format": "uri"
                      },
                      "description": "Array of character reference image URLs. Up to 2 images are supported. Index 0 is the portrait image, and index 1 is the body image. The body image is optional, but if provided, the portrait image must be present at index 0.\n\nImage limits:\n- Each image must be no larger than `20MB`\n- Use a publicly accessible image URL",
                      "examples": [
                        [
                          "https://example.com/assets/character-portrait.png",
                          "https://example.com/assets/character-body.png"
                        ]
                      ]
                    },
                    "audio_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Array of audio IDs generated by the `gemini-omni-audio` endpoint. These can be used to provide voice traits, tone, or persona guidance for the character.",
                      "examples": [
                        [
                          "audio_01hx8p0demo"
                        ]
                      ]
                    },
                    "character_name": {
                      "type": "string",
                      "description": "Character name"
                    }
                  }
                },
                "example": {
                  "description": "A young female character with short silver hair and a futuristic utility jacket, calm, agile, and strongly cyberpunk in style.",
                  "image_urls": [
                    "https://example.com/assets/character-reference.png"
                  ],
                  "audio_ids": [
                    "audio_01hx8p0demo"
                  ],
                  "character_name": "Jenny"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Request successful",
              "content": {
                "application/json": {
                  "schema": {
                    "allOf": [
                      {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "integer",
                            "description": "Status code of the request. The HTTP status is 200 even when the request fails, so always check this field: 200 means success; any other value means the request failed and msg describes the reason. Common values: 401 invalid or missing API key; 402 insufficient credits; 429 rate limit exceeded; 422 or 500 the request could not be processed (read msg and check your parameters before retrying)."
                          },
                          "data": {
                            "type": "object",
                            "properties": {
                              "characterId": {
                                "type": "string"
                              },
                              "characterName": {
                                "type": "string"
                              },
                              "imageUrl": {
                                "type": "string"
                              },
                              "bodyImageUrl": {
                                "type": "string"
                              }
                            }
                          },
                          "msg": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "example": {
                    "code": 200,
                    "msg": "success",
                    "data": {
                      "characterId": "b09dbf56...",
                      "characterName": "cute character",
                      "imageUrl": "https://xx.com/profile.png",
                      "bodyImageUrl": "https://xx.com/body.png"
                    }
                  }
                }
              },
              "headers": {}
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      }
    },
    "webhooks": {},
    "components": {
      "schemas": {},
      "responses": {},
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "API Key",
          "description": "All API requests require a Bearer Token. Add the header `Authorization: Bearer YOUR_API_KEY` to authenticate requests."
        }
      }
    },
    "servers": [
      {
        "url": "https://api.kie.ai",
        "description": "正式环境"
      }
    ],
    "security": [
      {
        "BearerAuth": []
      }
    ]
  }
}
